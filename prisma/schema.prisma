// Pieces Places Studio — tattoo shop management
// Auth models are generated by Better Auth CLI (`pnpm auth:generate`).
// Money columns are integer satang (1 THB = 100 satang). Percent columns are 0–100;
// shop % = 100 − artist − referral. Floor rounding; remainder to shop.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  role       String?
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  ownedJobs              Job[]               @relation("JobOwner")
  referredJobs           Job[]               @relation("JobReferrer")
  createdJobs            Job[]               @relation("JobCreatedBy")
  collaborations         JobCollaborator[]
  createdPayments        PaymentEntry[]      @relation("PaymentCreatedBy")
  reviewedPayments       PaymentEntry[]      @relation("PaymentReviewedBy")
  requestedCloses        JobClose[]          @relation("CloseRequestedBy")
  decidedCloses          JobClose[]          @relation("CloseDecidedBy")
  entitlements           PayoutEntitlement[]
  payoutBatches          PayoutBatch[]       @relation("PayoutPayee")
  createdPayoutBatches   PayoutBatch[]       @relation("PayoutCreatedBy")
  paidPayoutBatches      PayoutBatch[]       @relation("PayoutPaidBy")
  createdExpenses        Expense[]           @relation("ExpenseCreatedBy")
  reviewedExpenses       Expense[]           @relation("ExpenseReviewedBy")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum ServiceType {
  tattoo
  nail
  lash
  class
  other
}

enum GuestEngagement {
  none
  guest_sourced
  shop_overflow
}

enum JobStatus {
  open
  awaiting_close_approval
  closed
}

enum CloseOutcome {
  completed
  forfeit_deposit
  refund_deposit
}

enum PaymentKind {
  inbound_shop
  inbound_held_by_guest
  shop_cut_from_guest
  payout_to_guest
  refund_to_customer
}

enum ReviewStatus {
  pending
  approved
  rejected
}

enum EntitlementRole {
  artist
  referral
  forfeit_share
}

enum PayoutBatchKind {
  cycle
  advance
}

enum PayoutBatchStatus {
  pending
  paid
  cancelled
}

model SplitTemplate {
  id              String          @id @default(cuid())
  key             String          @unique
  label           String
  serviceType     ServiceType
  guestEngagement GuestEngagement @default(none)
  artistPct       Int
  referralPct     Int             @default(0)
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  jobs            Job[]

  @@index([serviceType, guestEngagement])
  @@map("split_template")
}

model GuestProfile {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  note      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jobs      Job[]

  @@map("guest_profile")
}

model Job {
  id                   String          @id @default(cuid())
  jobNo                Int             @unique
  title                String
  serviceType          ServiceType
  scheduledAt          DateTime
  styleNote            String?
  customerName         String?
  estimatedTotalSatang Int?
  guestEngagement      GuestEngagement @default(none)
  ownerUserId          String?
  ownerUser            User?           @relation("JobOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  ownerGuestId         String?
  ownerGuest           GuestProfile?   @relation(fields: [ownerGuestId], references: [id], onDelete: SetNull)
  referralUserId       String?
  referralUser         User?           @relation("JobReferrer", fields: [referralUserId], references: [id], onDelete: SetNull)
  splitTemplateId      String?
  splitTemplate        SplitTemplate?  @relation(fields: [splitTemplateId], references: [id], onDelete: SetNull)
  artistPct            Int
  referralPct          Int             @default(0)
  status               JobStatus       @default(open)
  createdById          String
  createdBy            User            @relation("JobCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  collaborators JobCollaborator[]
  payments      PaymentEntry[]
  closes        JobClose[]
  entitlements  PayoutEntitlement[]
  tags          JobTag[]

  @@index([status])
  @@index([ownerUserId])
  @@index([ownerGuestId])
  @@index([referralUserId])
  @@index([scheduledAt])
  @@map("job")
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jobs      JobTag[]

  @@map("tag")
}

model JobTag {
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([jobId, tagId])
  @@index([tagId])
  @@map("job_tag")
}

model JobCollaborator {
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([jobId, userId])
  @@index([userId])
  @@map("job_collaborator")
}

model PaymentEntry {
  id           String       @id @default(cuid())
  jobId        String
  job          Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  kind         PaymentKind
  amountSatang Int
  receivedAt   DateTime     @default(now())
  note         String?
  evidenceUrl  String?
  status       ReviewStatus @default(pending)
  rejectReason String?
  createdById  String
  createdBy    User         @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedById String?
  reviewedBy   User?        @relation("PaymentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  depositOf    JobClose[]   @relation("CloseDeposit")

  @@index([jobId, status])
  @@index([status, receivedAt])
  @@map("payment_entry")
}

model JobClose {
  id               String        @id @default(cuid())
  jobId            String
  job              Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  outcome          CloseOutcome
  depositPaymentId String?
  depositPayment   PaymentEntry? @relation("CloseDeposit", fields: [depositPaymentId], references: [id], onDelete: SetNull)
  status           ReviewStatus  @default(pending)
  rejectReason     String?
  requestedById    String
  requestedBy      User          @relation("CloseRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedById      String?
  decidedBy        User?         @relation("CloseDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt        DateTime?
  baseSatang       Int?
  ownerSatang      Int?
  referralSatang   Int?
  shopSatang       Int?
  refundSatang     Int?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  entitlements     PayoutEntitlement[]

  @@index([jobId])
  @@index([status, decidedAt])
  @@map("job_close")
}

model PayoutEntitlement {
  id            String          @id @default(cuid())
  jobId         String
  job           Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobCloseId    String
  jobClose      JobClose        @relation(fields: [jobCloseId], references: [id], onDelete: Cascade)
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  role          EntitlementRole
  amountSatang  Int
  payoutBatchId String?
  payoutBatch   PayoutBatch?    @relation(fields: [payoutBatchId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())

  @@unique([jobId, userId, role])
  @@index([userId, payoutBatchId])
  @@map("payout_entitlement")
}

model PayoutBatch {
  id           String            @id @default(cuid())
  kind         PayoutBatchKind
  userId       String
  user         User              @relation("PayoutPayee", fields: [userId], references: [id], onDelete: Restrict)
  cycleDate    DateTime?
  status       PayoutBatchStatus @default(pending)
  totalSatang  Int
  evidenceUrl  String?
  note         String?
  cancelReason String?
  createdById  String
  createdBy    User              @relation("PayoutCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  paidById     String?
  paidBy       User?             @relation("PayoutPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  paidAt       DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  entitlements PayoutEntitlement[]

  @@index([userId, status])
  @@index([status, paidAt])
  @@map("payout_batch")
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expenses  Expense[]

  @@map("expense_category")
}

model Expense {
  id           String          @id @default(cuid())
  categoryId   String
  category     ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amountSatang Int
  spentAt      DateTime
  note         String?
  evidenceUrl  String?
  status       ReviewStatus    @default(pending)
  rejectReason String?
  createdById  String
  createdBy    User            @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedById String?
  reviewedBy   User?           @relation("ExpenseReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([status, spentAt])
  @@index([categoryId])
  @@map("expense")
}
