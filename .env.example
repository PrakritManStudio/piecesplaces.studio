# Prisma
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/piecesplaces?schema=public"

# Better Auth
BETTER_AUTH_SECRET="replace-with-openssl-rand-base64-32"
# Dev tunnel (fallback local: http://localhost:3000)
BETTER_AUTH_URL="https://tunnel-prakrit-3000.patavee.space"

# Google OAuth (optional while using temp email/password login)
# https://console.cloud.google.com/apis/credentials
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: also promote this signed-in user to admin on `pnpm db:seed`
SEED_ADMIN_EMAIL=""

# Temp email/password admin is created by seed:
#   email: admin@admin.admin
#   password: admin@admin.admin
