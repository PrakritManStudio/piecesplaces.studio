# Prisma
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/piecesplaces?schema=public"

# Better Auth
BETTER_AUTH_SECRET="replace-with-openssl-rand-base64-32"
# Dev tunnel (fallback local: http://localhost:3000)
BETTER_AUTH_URL="https://tunnel-prakrit-3000.patavee.space"

# Google OAuth (required for staff login — email/password is disabled)
# https://console.cloud.google.com/apis/credentials
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
# Sign-up is disabled: create the user first (admin plugin / seed), then they sign in with Google.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: promote this signed-in user to admin on `pnpm db:seed`
SEED_ADMIN_EMAIL=""

# Cloudflare R2 — location hint when creating bucket: apac
R2_ACCOUNT_ID=""
R2_BUCKET_NAME="piecesplaces-studio"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
